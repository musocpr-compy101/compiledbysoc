# Copy to .env.local. Public keys identify the project; RLS protects its records.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only R2 credentials, scoped to this private bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Used to check upload request origins. No trailing slash.
APP_URL=http://localhost:3000
# Keep false until the election launch checklist and a test election pass.
ELECTION_VOTING_ENABLED=false
# Server-only. Used ONLY for administrator-created executive accounts and guest payments.
SUPABASE_SERVICE_ROLE_KEY=
# Begin with a Paystack test secret. Never prefix either secret with NEXT_PUBLIC_.
PAYSTACK_SECRET_KEY=
